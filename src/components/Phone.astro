---
import { menu } from '../data/projects';
import { person } from '../data/site';
import { takeCall, ticketOf, type MenuItem } from '../lib/order';

const items: MenuItem[] = menu.map((p) => ({
  number: p.number,
  slug: p.slug,
  name: p.name,
  short: p.short,
  result: p.result,
  combos: p.combos,
  aliases: p.aliases,
  kitchen: Boolean(p.kitchen),
}));
const facts = { email: 'the address on the order pad', seeking: person.seeking, graduation: person.graduation };

// The page opens with one call already taken, so it shows what it does before anyone types.
const sample = takeCall("what's good if I need a backend intern? and hold the buzzwords", items, facts, () => 0);
const suggestions = ["what's good for an embedded team?", 'tell me about W1', "I'll have the general tso's chicken", 'can I get two S2', 'how do I reach him?'];
---
<section class="band phone-band" id="phone" aria-labelledby="phone-title">
  <div class="wrap" data-phone data-menu={JSON.stringify(items)} data-seeking={person.seeking} data-graduation={person.graduation} data-user={person.email.user} data-domain={person.email.domain}>
    <h2 class="section-title" id="phone-title">Call the restaurant</h2>
    <p class="lede">A small version of what I built at Osho. Ask a question or place an order, and watch your words turn into a structured, validated ticket. This one is rule-based, so it costs nothing and can't go off script. The real one used LLM agents on live calls.</p>
    <div class="phone-grid">
      <div class="wallphone" data-wallphone>
        <svg class="phone-body" viewBox="0 0 170 300" aria-hidden="true">
          <rect x="3" y="3" width="164" height="294" rx="18" fill="#e9dcc0" stroke="#16130e" stroke-width="3" />
          <rect x="46" y="22" width="104" height="38" rx="4" fill="#f5f6f2" stroke="#16130e" stroke-width="2" />
          <text x="98" y="47" text-anchor="middle" font-family="VT323, monospace" font-size="17" fill="#ab1018">HOUSE OF CHEN</text>
          <g fill="#f5efe1" stroke="#16130e" stroke-width="2">
            {[0, 1, 2, 3].map((row) => [0, 1, 2].map((col) => (
              <rect x={56 + col * 32} y={84 + row * 34} width="26" height="24" rx="4" />
            )))}
          </g>
          <g font-family="VT323, monospace" font-size="17" text-anchor="middle" fill="#16130e">
            {['1', '2', '3', '4', '5', '6', '7', '8', '9', '*', '0', '#'].map((k, i) => (
              <text x={69 + (i % 3) * 32} y={101 + Math.floor(i / 3) * 34}>{k}</text>
            ))}
          </g>
          <path d="M3 40h20v220H3" fill="#d9c9a8" stroke="#16130e" stroke-width="2.5" />
        </svg>
        <canvas class="cord" aria-hidden="true"></canvas>
        <button class="handset" type="button" aria-pressed="false" aria-label="Pick up the phone">
          <svg viewBox="0 0 64 250" aria-hidden="true">
            <path d="M14 6h36c6 0 10 4 10 10v34c0 6-4 10-10 10h-6c-3 0-5 2-5 5v120c0 3 2 5 5 5h6c6 0 10 4 10 10v34c0 6-4 10-10 10H14c-6 0-10-4-10-10v-34c0-6 4-10 10-10h6c3 0 5-2 5-5V65c0-3-2-5-5-5h-6C8 60 4 56 4 50V16C4 10 8 6 14 6z" fill="#e9dcc0" stroke="#16130e" stroke-width="3" stroke-linejoin="round" />
            <g fill="#16130e"><circle cx="24" cy="26" r="2.4" /><circle cx="32" cy="22" r="2.4" /><circle cx="40" cy="26" r="2.4" /><circle cx="32" cy="32" r="2.4" /><circle cx="24" cy="224" r="2.4" /><circle cx="32" cy="228" r="2.4" /><circle cx="40" cy="224" r="2.4" /><circle cx="32" cy="218" r="2.4" /></g>
          </svg>
        </button>
      </div>
      <div class="screen">
        <form class="call-form" data-call-form>
          <label for="call-input">Say something</label>
          <div class="call-row">
            <input id="call-input" name="said" autocomplete="off" placeholder="what's good for an embedded team?" />
            <button class="key" type="submit">Send</button>
            <button class="key key-quiet" type="button" data-mic aria-pressed="false" hidden>Talk</button>
          </div>
          <div class="suggestions" aria-label="Try one">
            {suggestions.map((s) => <button class="suggestion" type="button" data-say={s}>{s}</button>)}
          </div>
        </form>
        <ol class="stages" data-stages aria-label="How the call was understood">
          {sample.stages.map((s) => (
            <li class="stage"><span class="stage-name">{s.name}</span><span class="stage-detail">{s.detail}</span><span class="stage-ms">&lt;0.01 ms</span></li>
          ))}
        </ol>
        <pre class="call-ticket" data-call-ticket tabindex="0" aria-label="The structured order">{JSON.stringify(ticketOf(sample), null, 2)}</pre>
        <p class="call-reply" data-call-reply aria-live="polite">{sample.reply}</p>
        <p class="phone-note">Voice works in browsers with speech recognition, which sends audio to the browser maker's speech service. Typing works everywhere.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { takeCall, ticketOf, type Facts, type MenuItem } from '../lib/order';
  import { clamp, spring } from '../lib/physics';
  import { play, soundOn } from '../lib/sound';

  const root = document.querySelector<HTMLElement>('[data-phone]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const menu: MenuItem[] = JSON.parse(root.dataset.menu ?? '[]');
    const facts: Facts = {
      email: `${root.dataset.user}@${root.dataset.domain}`,
      seeking: root.dataset.seeking ?? '',
      graduation: root.dataset.graduation ?? '',
    };
    const form = root.querySelector<HTMLFormElement>('[data-call-form]')!;
    const input = root.querySelector<HTMLInputElement>('#call-input')!;
    const stages = root.querySelector<HTMLElement>('[data-stages]')!;
    const ticket = root.querySelector<HTMLElement>('[data-call-ticket]')!;
    const replyEl = root.querySelector<HTMLElement>('[data-call-reply]')!;
    const mic = root.querySelector<HTMLButtonElement>('[data-mic]')!;

    // The handset and its coiled cord.
    const phone = root.querySelector<HTMLElement>('[data-wallphone]')!;
    const handset = phone.querySelector<HTMLButtonElement>('.handset')!;
    const canvas = phone.querySelector<HTMLCanvasElement>('.cord')!;
    const ctx = canvas.getContext('2d');
    const BASE = { left: 22, top: 34, w: 64, h: 250 };
    const JACK = { x: 106, y: 312 };
    const REST = { x: 0, y: 0, r: 0 };
    const LIFTED = { x: 24, y: 64, r: -30 };
    let pos = { ...REST };
    let vel = { x: 0, y: 0, r: 0 };
    let goal = { ...REST };
    let held = false;
    let dragging = false;
    let draggedFar = false;
    let frame = 0;
    let last = 0;
    let grab = { x: 0, y: 0, ox: 0, oy: 0 };

    const cordEnd = () => {
      const cx = BASE.left + BASE.w / 2 + pos.x;
      const cy = BASE.top + BASE.h / 2 + pos.y;
      const a = (pos.r * Math.PI) / 180;
      const reach = BASE.h / 2 - 10;
      return { x: cx - reach * Math.sin(a), y: cy + reach * Math.cos(a) };
    };

    const drawCord = () => {
      if (!ctx) return;
      const dpr = window.devicePixelRatio || 1;
      const w = phone.clientWidth;
      const h = phone.clientHeight;
      if (canvas.width !== Math.round(w * dpr)) {
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const end = cordEnd();
      const reach = Math.hypot(end.x - JACK.x, end.y - JACK.y);
      const sag = Math.max(18, 120 - reach * 0.35);
      const c = { x: (JACK.x + end.x) / 2, y: Math.max(JACK.y, end.y) + sag };
      const coils = 16;
      const amp = 6;
      const steps = 360;
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const mt = 1 - t;
        const x = mt * mt * JACK.x + 2 * mt * t * c.x + t * t * end.x;
        const y = mt * mt * JACK.y + 2 * mt * t * c.y + t * t * end.y;
        const tx = 2 * mt * (c.x - JACK.x) + 2 * t * (end.x - c.x);
        const ty = 2 * mt * (c.y - JACK.y) + 2 * t * (end.y - c.y);
        const len = Math.hypot(tx, ty) || 1;
        const ux = tx / len;
        const uy = ty / len;
        const phase = t * coils * Math.PI * 2;
        const taper = Math.min(1, t * 14, (1 - t) * 14);
        // Offsets along the normal and the tangent draw loops that open up as the cord stretches.
        const px = x + (-uy * Math.sin(phase) + ux * Math.cos(phase) * 0.9) * amp * taper;
        const py = y + (ux * Math.sin(phase) + uy * Math.cos(phase) * 0.9) * amp * taper;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#16130e';
      ctx.lineWidth = 4.2;
      ctx.stroke();
      ctx.strokeStyle = '#d9c9a8';
      ctx.lineWidth = 2.2;
      ctx.stroke();
    };

    const paintHandset = () => {
      handset.style.transform = `translate(${pos.x.toFixed(1)}px, ${pos.y.toFixed(1)}px) rotate(${pos.r.toFixed(1)}deg)`;
      drawCord();
    };

    const step = (t: number) => {
      const dt = Math.min(0.032, (t - last) / 1000 || 0.016);
      last = t;
      if (!dragging) {
        [pos.x, vel.x] = spring(pos.x, vel.x, goal.x, 70, 12, dt);
        [pos.y, vel.y] = spring(pos.y, vel.y, goal.y, 70, 12, dt);
        [pos.r, vel.r] = spring(pos.r, vel.r, goal.r, 70, 12, dt);
      }
      paintHandset();
      const settled =
        !dragging &&
        Math.abs(pos.x - goal.x) < 0.1 &&
        Math.abs(pos.y - goal.y) < 0.1 &&
        Math.abs(pos.r - goal.r) < 0.1 &&
        Math.hypot(vel.x, vel.y, vel.r) < 1;
      if (settled) {
        pos = { ...goal };
        paintHandset();
        frame = 0;
        return;
      }
      frame = requestAnimationFrame(step);
    };

    const run = () => {
      if (calm) {
        pos = { ...goal };
        paintHandset();
        return;
      }
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(step);
    };

    const pickUp = () => {
      if (held) return;
      held = true;
      goal = { ...LIFTED };
      handset.setAttribute('aria-pressed', 'true');
      handset.setAttribute('aria-label', 'Hang up the phone');
      run();
    };

    const hangUp = () => {
      held = false;
      goal = { ...REST };
      handset.setAttribute('aria-pressed', 'false');
      handset.setAttribute('aria-label', 'Pick up the phone');
      play('hang');
      run();
    };

    handset.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      draggedFar = false;
      handset.setPointerCapture(e.pointerId);
      grab = { x: e.clientX, y: e.clientY, ox: pos.x, oy: pos.y };
      vel = { x: 0, y: 0, r: 0 };
    });

    handset.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - grab.x;
      const dy = e.clientY - grab.y;
      if (Math.hypot(dx, dy) > 6) draggedFar = true;
      pos.x = clamp(grab.ox + dx, -16, 150);
      pos.y = clamp(grab.oy + dy, -20, 110);
      pos.r = -30 * Math.min(1, Math.hypot(pos.x, pos.y) / 80);
      paintHandset();
    });

    const drop = () => {
      if (!dragging) return;
      dragging = false;
      if (!draggedFar) return;
      if (Math.hypot(pos.x, pos.y) < 40) hangUp();
      else {
        held = true;
        goal = { ...pos };
        handset.setAttribute('aria-pressed', 'true');
        handset.setAttribute('aria-label', 'Hang up the phone');
        run();
      }
    };
    handset.addEventListener('pointerup', drop);
    handset.addEventListener('pointercancel', drop);

    handset.addEventListener('click', () => {
      if (draggedFar) {
        draggedFar = false;
        return;
      }
      if (held) hangUp();
      else {
        pickUp();
        input.focus({ preventScroll: true });
      }
    });

    addEventListener('resize', drawCord);
    paintHandset();

    // The call itself.
    const span = (className: string, text: string) => {
      const el = document.createElement('span');
      el.className = className;
      el.textContent = text;
      return el;
    };

    const answer = (said: string) => {
      const call = takeCall(said, menu, facts);
      stages.replaceChildren(
        ...call.stages.map((s) => {
          const li = document.createElement('li');
          li.className = 'stage';
          li.append(span('stage-name', s.name), span('stage-detail', s.detail), span('stage-ms', s.ms < 0.01 ? '<0.01 ms' : `${s.ms.toFixed(2)} ms`));
          return li;
        }),
      );
      ticket.textContent = JSON.stringify(ticketOf(call), null, 2);
      replyEl.textContent = call.reply;
      play(call.check.valid ? 'ding' : 'stamp');
      if (soundOn() && 'speechSynthesis' in window) {
        speechSynthesis.cancel();
        speechSynthesis.speak(new SpeechSynthesisUtterance(call.reply));
      }
      pickUp();
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const said = input.value.trim();
      if (said) answer(said);
    });

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-say]')) {
      button.addEventListener('click', () => {
        input.value = button.dataset.say ?? '';
        answer(input.value);
      });
    }

    type Recognizer = {
      lang: string;
      interimResults: boolean;
      onresult: ((event: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;
      onend: (() => void) | null;
      start: () => void;
    };
    const Speech = (window as unknown as { SpeechRecognition?: new () => Recognizer; webkitSpeechRecognition?: new () => Recognizer })
      .SpeechRecognition ?? (window as unknown as { webkitSpeechRecognition?: new () => Recognizer }).webkitSpeechRecognition;
    if (Speech) {
      mic.hidden = false;
      mic.addEventListener('click', () => {
        const recognizer = new Speech();
        recognizer.lang = 'en-US';
        recognizer.interimResults = false;
        recognizer.onresult = (event) => {
          const text = event.results[0][0].transcript;
          input.value = text;
          answer(text);
        };
        recognizer.onend = () => mic.setAttribute('aria-pressed', 'false');
        mic.setAttribute('aria-pressed', 'true');
        recognizer.start();
      });
    }
  }
</script>
