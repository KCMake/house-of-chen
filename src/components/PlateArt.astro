---
import type { PlateArt } from '../data/types';

interface Props {
  art: PlateArt;
}

// Drawn stand-ins until the real hardware is photographed on the restaurant's dishes.
const { art } = Astro.props;
---
{art === 'phone' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"><path d="M10 22c0-6 10-10 22-10s22 4 22 10v4c0 2-1.5 3-3.5 3h-7c-2 0-3.5-1-3.5-3v-3.5c-4-1.2-12-1.2-16 0V26c0 2-1.5 3-3.5 3h-7c-2 0-3.5-1-3.5-3z" fill="#ab1018" /><path d="M21 32h22l6 18c.6 2-.6 4-3 4H18c-2.4 0-3.6-2-3-4z" fill="#f0b92f" /><circle cx="32" cy="43" r="6.5" fill="#f5f6f2" /></g></svg>
)}
{art === 'map' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 18h48M8 34h48M8 50h48M20 8v48M36 8v48M50 8v48" stroke="#8fb09a" stroke-width="2" fill="none" stroke-linecap="round" /><path d="M32 12c-6.5 0-11 4.7-11 10.6C21 30 32 44 32 44s11-14 11-21.4C43 16.7 38.5 12 32 12z" fill="#ab1018" stroke="#16130e" stroke-width="2" /><circle cx="32" cy="23" r="4" fill="#f5f6f2" stroke="#16130e" stroke-width="2" /></svg>
)}
{art === 'board' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="17" y="10" width="26" height="44" rx="1.5" fill="#1f5f4a" /><rect x="22" y="16" width="16" height="16" fill="#b3babf" /><path d="M13 16h4M13 22h4M13 28h4M13 34h4M13 40h4M13 46h4M43 16h4M43 22h4M43 28h4M43 34h4M43 40h4M43 46h4" fill="none" /><circle cx="30" cy="44" r="3" fill="#f0b92f" /><path d="M47 54c8-1 13-7 13-14-8 0-14 6-13 14z" fill="#6aa84f" /></g></svg>
)}
{art === 'steamer' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2" stroke-linejoin="round"><circle cx="32" cy="32" r="26" fill="#d9b779" /><circle cx="32" cy="32" r="21" fill="#f5f6f2" /><g fill="#b3babf"><rect x="19" y="20" width="12" height="11" rx="2" /><rect x="34" y="22" width="12" height="11" rx="2" /><rect x="26" y="36" width="12" height="11" rx="2" /></g></g><g fill="#16130e"><circle cx="23" cy="25" r="1.3" /><circle cx="27" cy="25" r="1.3" /><circle cx="38" cy="27" r="1.3" /><circle cx="42" cy="27" r="1.3" /><circle cx="30" cy="41" r="1.3" /><circle cx="34" cy="41" r="1.3" /></g></svg>
)}
{art === 'moon' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M40 11a21 21 0 1 0 13 32 17 17 0 0 1-13-32z" fill="#f0b92f" /><path d="M42 27v10M47 23v18M52 29v6" fill="none" /></g></svg>
)}
{art === 'storefront' && (
  <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><rect x="16" y="28" width="32" height="24" fill="#f5f6f2" /><path d="M12 28l5-14h30l5 14z" fill="#ab1018" /><path d="M24 14l-2 14M32 14v14M40 14l2 14" fill="none" /><rect x="27" y="36" width="10" height="16" fill="#f0b92f" /></g><g fill="#1c3da3"><circle cx="8" cy="44" r="2" /><circle cx="56" cy="40" r="2" /><circle cx="58" cy="52" r="2" /><circle cx="6" cy="56" r="2" /><circle cx="52" cy="10" r="2" /><circle cx="10" cy="12" r="2" /></g></svg>
)}
