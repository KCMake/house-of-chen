---
import type { Printout } from '../data/types';
import { dedent, highlightLines } from '../lib/highlight';

interface Props {
  printout: Printout;
}

const { printout } = Astro.props;
const lines = highlightLines(dedent(printout.code), printout.lang);
const end = printout.startLine + lines.length - 1;
---
<figure class="printout">
  <figcaption class="printout-head">
    <span>{printout.file}</span>
    <span>LINES {printout.startLine} TO {end}</span>
    <a href={printout.url}>View on GitHub</a>
  </figcaption>
  <div class="greenbar" tabindex="0" aria-label={`${printout.file}, lines ${printout.startLine} to ${end}`}>
    <pre><code>{lines.map((line, i) => (
      <span class="ln"><span class="no">{printout.startLine + i}</span><span set:html={line || ' '} /></span>
    ))}</code></pre>
  </div>
  <p class="printout-note">{printout.note}</p>
</figure>
