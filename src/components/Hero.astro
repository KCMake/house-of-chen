---
import { person } from '../data/site';
import { url } from '../lib/url';

// The first screen is a kitchen ticket, and the ticket is the resume.
const ticket = [
  '     HOUSE OF CHEN',
  '   EAT IN / TAKE OUT',
  '',
  'ORDER 2029     TABLE 1',
  'SERVER: KENNEY CHEN',
  '-----------------------',
  '1 COMPUTER ENGINEERING',
  '  GEORGIA TECH  GPA 4.00',
  '1 AI PHONE ORDERING',
  '  LIVE IN A RESTAURANT',
  '1 BUILDFORGE',
  '  5,000+ MEMBERS',
  '1 AGRINEXUS 2.0',
  '  TSA NATIONAL FINALIST',
  '-----------------------',
  'NOW SEEKING',
  'SWE INTERN, SUMMER 2027',
].join('\n');
---
<section class="band menu-stock hero" id="top" aria-labelledby="hero-title">
  <div class="rail" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-name">{person.name}</p>
      <h1 class="mega" id="hero-title">
        <span class="visually-hidden">{person.name}: </span>Full stack<br /> since <span class="yr">2016<svg class="pen" viewBox="0 0 56 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M7 21C3 9 18 3 30 3c14 1 22 9 20 19-2 11-20 15-34 12C6 32 1 24 9 13" /></svg></span>.
      </h1>
      <p class="pen-note">cook, cashier, shift manager.</p>
      <p class="hero-sub">I grew up working in my family's restaurant in Atlanta. Now I study Computer Engineering at Georgia Tech and build software that has to hold up during the dinner rush.</p>
      <p class="seek">{person.seeking}.</p>
      <ul class="quick-links">
        <li><a class="key key-small" href={url(person.resumePdf)} download>Resume PDF</a></li>
        <li><a class="key key-small" href="#order" data-mail={person.email.user} data-domain={person.email.domain}>Email</a></li>
        <li><a class="key key-small" href={person.linkedin} rel="me">LinkedIn</a></li>
        <li><a class="key key-small" href={person.github} rel="me">GitHub</a></li>
      </ul>
    </div>
    <div class="ticket-col">
      <div class="ticket-feed" data-ticket-feed>
        <div class="ticket-slide">
          <div class="ticket-hang">
            <div class="ticket">
              <pre>{ticket}</pre>
              <div class="pos">
                <a class="key" href="#menu">For here</a>
                <a class="key" href={url('to-go/')}>To go</a>
              </div>
            </div>
            <a class="stub" href={url(person.resumePdf)} download draggable="false" data-stub>
              TEAR HERE FOR A COPY
              <small>Pull it down, or click, for the PDF</small>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { play } from '../lib/sound';

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Once the ticket has printed out of the rail, stop clipping it so the stub can be pulled.
  const feed = document.querySelector<HTMLElement>('[data-ticket-feed]');
  const slide = feed?.querySelector<HTMLElement>('.ticket-slide');
  if (feed && slide) {
    const printed = () => feed.classList.add('printed');
    if (calm || getComputedStyle(slide).animationName === 'none') printed();
    else slide.addEventListener('animationend', printed, { once: true });
  }

  const stub = document.querySelector<HTMLAnchorElement>('[data-stub]');
  if (stub) {
    let startY = 0;
    let pulled = 0;
    let dragging = false;
    let moved = false;
    const stretch = (d: number) => (d < 60 ? d : 60 + (d - 60) * 0.3);

    stub.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      moved = false;
      startY = e.clientY;
      pulled = 0;
      stub.setPointerCapture(e.pointerId);
    });

    stub.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      pulled = Math.max(0, e.clientY - startY);
      if (pulled > 4) moved = true;
      const p = stretch(pulled);
      stub.style.transform = `translateY(${p}px) rotate(${Math.min(p / 14, 4)}deg)`;
      stub.classList.toggle('straining', pulled > 45);
    });

    const release = () => {
      if (!dragging) return;
      dragging = false;
      stub.classList.remove('straining');
      if (pulled > 80) {
        rip();
      } else if (moved) {
        const from = stub.style.transform;
        stub.style.transform = '';
        if (!calm) stub.animate([{ transform: from }, { transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.3,1.5,.5,1)' });
      }
    };
    stub.addEventListener('pointerup', release);
    stub.addEventListener('pointercancel', release);

    // A drag that moved is never also a click, so it can't download twice.
    stub.addEventListener('click', (e) => {
      if (moved) e.preventDefault();
    });

    function rip() {
      if (!stub) return;
      play('rip');
      const box = stub.getBoundingClientRect();
      const piece = stub.cloneNode(true) as HTMLElement;
      piece.removeAttribute('href');
      piece.removeAttribute('data-stub');
      piece.setAttribute('aria-hidden', 'true');
      piece.classList.add('stub-falling');
      Object.assign(piece.style, {
        position: 'fixed',
        left: `${box.left}px`,
        top: `${box.top}px`,
        width: `${box.width}px`,
        margin: '0',
        zIndex: '60',
      });
      document.body.append(piece);
      stub.style.transform = '';
      stub.classList.add('gone');
      piece
        .animate(
          [{ transform: 'none' }, { transform: `translate(60px, ${innerHeight - box.top + 80}px) rotate(32deg)` }],
          { duration: calm ? 1 : 950, easing: 'cubic-bezier(.45,0,.9,.55)', fill: 'forwards' },
        )
        .finished.then(() => piece.remove(), () => piece.remove());

      const download = document.createElement('a');
      download.href = stub.href;
      download.download = '';
      document.body.append(download);
      download.click();
      download.remove();

      window.setTimeout(() => {
        stub.classList.remove('gone');
        play('print');
        if (!calm) stub.animate([{ transform: 'translateY(-100%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 600, easing: 'steps(12, end)' });
      }, 1000);
    }
  }
</script>
