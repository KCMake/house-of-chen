---
import { emailSpoken, person } from '../data/site';
import { url } from '../lib/url';
---
<footer class="thanks" aria-labelledby="thanks-title">
  <h2 class="thanks-stack" id="thanks-title"><span>THANK YOU</span><span aria-hidden="true">THANK YOU</span><span aria-hidden="true">THANK YOU</span></h2>
  <svg class="smile" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="28" fill="none" stroke="#ab1018" stroke-width="4" /><circle cx="23" cy="26" r="3.5" fill="#ab1018" /><circle cx="41" cy="26" r="3.5" fill="#ab1018" /><path d="M19 39c7 9 19 9 26 0" fill="none" stroke="#ab1018" stroke-width="4" stroke-linecap="round" /></svg>
  <p class="nice-day">HAVE A NICE DAY</p>
  <div class="stapled">
    <ul>
      <li><a href="#order" data-mail={person.email.user} data-domain={person.email.domain} data-show-address>{emailSpoken}</a></li>
      <li><a href={person.linkedin}>LinkedIn</a></li>
      <li><a href={person.github}>GitHub</a></li>
      <li><a href={url(person.resumePdf)} download>Resume PDF</a></li>
      <li><a href={url('kitchen/')}>Back of house</a></li>
    </ul>
  </div>
  <p class="fineprint">Kenney Chen, 2026. The code is MIT licensed and <a href={person.repo}>on GitHub</a>. The words and photos are not.</p>
</footer>
