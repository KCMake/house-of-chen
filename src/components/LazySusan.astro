---
import { tableDishes } from '../data/projects';
import { url } from '../lib/url';
import PlateArt from './PlateArt.astro';

const dishes = tableDishes.map((p) => ({
  number: p.number,
  name: p.name,
  short: p.short,
  result: p.result,
  href: p.kitchen ? url(`kitchen/${p.slug}/`) : null,
}));
const first = dishes[0];
---
<section class="band table-band" id="table" aria-labelledby="table-title">
  <div class="wrap">
    <h2 class="section-title" id="table-title">The lazy Susan</h2>
    <p class="lede">The best of the menu, on a turntable. Spin it, and whatever stops in front of you is what you read about. On a phone it's a dial under your thumb. Don't spin it too hard while someone is serving.</p>
    <div class="table-demo">
      <div class="table-col">
        <span class="pointer" aria-hidden="true"></span>
        <div
          class="table"
          data-table
          data-dishes={JSON.stringify(dishes)}
          tabindex="0"
          role="slider"
          aria-label="Lazy Susan. Use the arrow keys to turn it."
          aria-valuemin="1"
          aria-valuemax={dishes.length}
          aria-valuenow="1"
          aria-valuetext={`${first.number}, ${first.name}`}
        >
          <div class="susan" data-susan>
            {tableDishes.map((p, i) => (
              <div class="dish" style={`--i:${i}`}><PlateArt art={p.plate!.art} /></div>
            ))}
            <div class="hub">
              <svg viewBox="0 0 64 64" aria-hidden="true"><g stroke="#16130e" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M50 30c6-4 10-2 10 2s-4 8-10 6M14 30L4 24M14 36L6 38" fill="none" /><circle cx="32" cy="33" r="19" fill="#f5f6f2" /><circle cx="32" cy="33" r="5" fill="#1f5f4a" /></g></svg>
            </div>
          </div>
          <div class="glare" aria-hidden="true"></div>
          <p class="slow" data-slow hidden>slow down, someone is still serving</p>
        </div>
        <svg class="seat" viewBox="0 0 120 34" aria-hidden="true"><g stroke="#16130e" stroke-linecap="round"><path d="M28 30L58 4" stroke-width="3.5" /><path d="M92 30L62 4" stroke-width="3.5" /></g><rect x="50" y="20" width="20" height="10" rx="3" fill="#ab1018" stroke="#16130e" stroke-width="2" /></svg>
      </div>
      <div class="dish-info" aria-live="polite">
        <p class="dish-no" data-dish-no>{first.number}</p>
        <h3 class="dish-name" data-dish-name>{first.name}</h3>
        <p data-dish-short>{first.short}</p>
        <p class="dish-res" data-dish-result>{first.result}</p>
        <div class="controls">
          <button class="key" type="button" data-turn="1">Previous</button>
          <button class="key" type="button" data-turn="-1">Next</button>
          <a class="door-link" data-dish-link href={first.href ?? '#menu'} hidden={!first.href}>Kitchen ticket</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { coast, dishAtFront, nearestDetent, releaseSpeed, spring, type Sample } from '../lib/physics';
  import { play } from '../lib/sound';

  interface Dish {
    number: string;
    name: string;
    short: string;
    result: string;
    href: string | null;
  }

  const table = document.querySelector<HTMLElement>('[data-table]');
  if (table) {
    const susan = table.querySelector<HTMLElement>('[data-susan]')!;
    const slow = table.querySelector<HTMLElement>('[data-slow]')!;
    const dishes: Dish[] = JSON.parse(table.dataset.dishes ?? '[]');
    const field = (name: string) => document.querySelector<HTMLElement>(`[data-dish-${name}]`)!;
    const link = document.querySelector<HTMLAnchorElement>('[data-dish-link]')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dial = matchMedia('(max-width: 640px)');
    const N = dishes.length;
    const STEP = 360 / N;
    const MAX_SPEED = 1600;

    let angle = 0;
    let speed = 0;
    let dragging = false;
    let frame = 0;
    let last = 0;
    let previous = 0;
    let target: number | null = null;
    let slot = 0;
    let slowTimer = 0;
    let samples: Sample[] = [];

    // On a phone the table becomes a dial: the front is at the top, under the thumb.
    const front = () => (dial.matches ? 180 : 0);

    const show = (i: number) => {
      const d = dishes[i];
      field('no').textContent = d.number;
      field('name').textContent = d.name;
      field('short').textContent = d.short;
      field('result').textContent = d.result;
      link.hidden = !d.href;
      if (d.href) link.href = d.href;
      table.setAttribute('aria-valuenow', String(i + 1));
      table.setAttribute('aria-valuetext', `${d.number}, ${d.name}`);
    };

    const paint = () => {
      susan.style.transform = `rotate(${(angle + front()).toFixed(2)}deg)`;
      const s = Math.round(angle / STEP);
      if (s !== slot) {
        slot = s;
        play('tick');
        show(dishAtFront(angle, STEP, N));
      }
    };

    const tick = (t: number) => {
      const dt = Math.min(0.032, (t - last) / 1000 || 0.016);
      last = t;
      if (!dragging) {
        if (target === null && Math.abs(speed) > 38) {
          // Coasting: friction slows it, and the detents tug a little as they pass.
          speed = coast(speed, 1.15, dt);
          speed += -70 * Math.sin((angle * 2 * Math.PI) / STEP) * dt;
          angle += speed * dt;
        } else {
          if (target === null) target = nearestDetent(angle, STEP);
          [angle, speed] = spring(angle, speed, target, 95, 18, dt);
          if (Math.abs(angle - target) < 0.04 && Math.abs(speed) < 0.6) {
            angle = target;
            speed = 0;
            target = null;
            paint();
            frame = 0;
            return;
          }
        }
      }
      paint();
      frame = requestAnimationFrame(tick);
    };

    const run = () => {
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const angleAt = (e: PointerEvent) => {
      const r = table.getBoundingClientRect();
      return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
    };

    table.addEventListener('pointerdown', (e) => {
      dragging = true;
      table.setPointerCapture(e.pointerId);
      previous = e.pointerType === 'touch' ? e.clientX : angleAt(e);
      samples = [{ t: e.timeStamp, value: angle }];
      speed = 0;
      target = null;
      run();
    });

    table.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      let delta: number;
      if (e.pointerType === 'touch') {
        // A thumb drags the edge nearest it, so the direction flips with the dial.
        delta = ((e.clientX - previous) / table.clientWidth) * 136 * (dial.matches ? 1 : -1);
        previous = e.clientX;
      } else {
        const now = angleAt(e);
        delta = now - previous;
        if (delta > 180) delta -= 360;
        if (delta < -180) delta += 360;
        previous = now;
      }
      angle += delta;
      samples.push({ t: e.timeStamp, value: angle });
      if (samples.length > 8) samples.shift();
      if (calm) paint();
    });

    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      const lastMove = samples[samples.length - 1];
      speed = e.timeStamp - lastMove.t > 90 ? 0 : releaseSpeed(samples, MAX_SPEED);
      if (Math.abs(speed) > 820) {
        slow.hidden = false;
        clearTimeout(slowTimer);
        slowTimer = window.setTimeout(() => (slow.hidden = true), 2400);
      }
      if (calm) {
        angle = nearestDetent(angle, STEP);
        speed = 0;
        paint();
      }
    };
    table.addEventListener('pointerup', release);
    table.addEventListener('pointercancel', release);

    const turn = (direction: number) => {
      target = (target ?? nearestDetent(angle, STEP)) + direction * STEP;
      speed = 0;
      if (calm) {
        angle = target;
        target = null;
        paint();
        return;
      }
      run();
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-turn]')) {
      button.addEventListener('click', () => turn(Number(button.dataset.turn)));
    }

    table.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        turn(-1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        turn(1);
      }
    });

    dial.addEventListener('change', paint);
    paint();
  }
</script>
