---
import { url } from '../lib/url';

interface Props {
  room: 'front' | 'kitchen';
}

const { room } = Astro.props;
---
<header class="signbar">
  <div class="signbar-inner">
    <a class="sign" href={url()}>House of Chen</a>
    <nav aria-label="Sections">
      {room === 'front' ? (
        <>
          <a href="#menu">Menu</a>
          <a href="#door">Kitchen door</a>
          <a href="#table">Table</a>
          <a href="#wall">Wall</a>
          <a href="#phone">Phone</a>
          <a href="#order">Order</a>
          <a href={url('to-go/')}>To go</a>
        </>
      ) : (
        <>
          <a href={url()}>Front of house</a>
          <a href={url('kitchen/')}>All tickets</a>
          <a href={url('to-go/')}>To go</a>
        </>
      )}
    </nav>
    <button class="switch" type="button" data-sound-switch aria-pressed="false">
      <span class="switch-rocker" aria-hidden="true"></span>
      <span>Sound <span class="switch-state" aria-hidden="true"></span></span>
    </button>
  </div>
</header>

<script>
  import { setSound, soundOn } from '../lib/sound';

  const button = document.querySelector<HTMLButtonElement>('[data-sound-switch]');
  if (button) {
    const sync = () => button.setAttribute('aria-pressed', String(soundOn()));
    sync();
    button.addEventListener('click', () => {
      setSound(!soundOn());
      sync();
    });
  }
</script>
