---
import { menu, sections } from '../data/projects';
import { combos } from '../data/site';
import { url } from '../lib/url';
import Packets from './Packets.astro';

// Two printed columns, balanced by hand. On a phone the sections fall back into menu order.
const columns = [
  ['specials', 'plates'],
  ['workshop', 'family'],
].map((ids) => ids.map((id) => sections.find((s) => s.id === id)!));
---
<section class="band menu-stock" id="menu" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="menu-top">
      <h2 class="section-title" id="menu-title">Menu</h2>
      <p class="menu-intro">Results go where the prices would. Pick a combo and a server circles what that reader should order. You can also type a number, like <kbd>W1</kbd>, to jump to it.</p>
    </div>
    <div class="combos" role="group" aria-label="Combo platters">
      {combos.map((c) => (
        <button class="key" type="button" data-combo={c.id} data-note={c.note} aria-pressed="false">{c.label}</button>
      ))}
      <button class="key key-quiet" type="button" data-combo="" data-note="" aria-pressed="false">Clear</button>
    </div>
    <p class="combo-note" data-combo-note aria-live="polite"></p>
    <div class="menu-cols">
      {columns.map((column) => (
        <div class="menu-col">
      {column.map((s) => {
        const items = menu.filter((p) => p.section === s.id);
        return items.length > 0 && (
          <div class="menu-section" data-section={s.id}>
            <h3 class="menu-head">{s.title}</h3>
            <ol class="items">
              {items.map((p) => (
                <li class="item" id={p.number} tabindex="-1" data-c={p.combos.join(' ')}>
                  <div class="line">
                    <span class="num">
                      {p.number}
                      <svg class="pen" viewBox="0 0 56 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M7 21C3 9 18 3 30 3c14 1 22 9 20 19-2 11-20 15-34 12C6 32 1 24 9 13" /></svg>
                    </span>
                    <span class="name">{p.name}{p.isNew && <span class="new">new</span>}</span>
                    <span class="dots" aria-hidden="true"></span>
                    <span class="price">{p.result}</span>
                  </div>
                  <p>{p.short}</p>
                  <div class="item-foot">
                    <Packets stack={p.stack} spice={p.spice} />
                    {p.kitchen && <a class="door-link" href={url(`kitchen/${p.slug}/`)}>Kitchen ticket</a>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        );
      })}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { play } from '../lib/sound';

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLElement>('.item')];
  const keys = [...document.querySelectorAll<HTMLButtonElement>('[data-combo]')];
  const note = document.querySelector<HTMLElement>('[data-combo-note]');

  // Combo platters: a server circles what that reader should order.
  for (const key of keys) {
    key.addEventListener('click', () => {
      const combo = key.dataset.combo ?? '';
      for (const k of keys) k.setAttribute('aria-pressed', String(k === key && combo !== ''));
      for (const item of items) {
        const hit = combo !== '' && (item.dataset.c ?? '').split(' ').includes(combo);
        item.classList.toggle('circled', hit);
        item.classList.toggle('faded', combo !== '' && !hit);
      }
      if (note) note.textContent = key.dataset.note ?? '';
      if (combo) play('stamp');
    });
  }

  // Order by number: type S, W, P, or F and a digit anywhere on the page.
  let typed = '';
  let timer = 0;
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
    const key = e.key.toLowerCase();
    if (/^[swpf]$/.test(key)) typed = key;
    else if (/^\d$/.test(key) && typed) typed += key;
    else {
      typed = '';
      return;
    }
    clearTimeout(timer);
    timer = window.setTimeout(() => (typed = ''), 1200);
    const item = typed.length > 1 ? document.getElementById(typed.toUpperCase()) : null;
    if (!item?.classList.contains('item')) return;
    item.scrollIntoView({ block: 'center', behavior: calm ? 'auto' : 'smooth' });
    item.focus({ preventScroll: true });
    item.classList.remove('ordered');
    void item.offsetWidth;
    item.classList.add('ordered');
    play('ding');
  });
</script>
