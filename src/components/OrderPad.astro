---
import { emailSpoken, person } from '../data/site';
---
<section class="band order-band" id="order" aria-labelledby="order-title">
  <div class="wrap">
    <h2 class="section-title" id="order-title">The order pad</h2>
    <p class="lede">Hit Fire and your message prints as a kitchen ticket, then opens in your email app, ready to send. Soon it will print for real, on a receipt printer on my desk run by an ESP32. Or write to <a href="#" data-mail={person.email.user} data-domain={person.email.domain} data-show-address>{emailSpoken}</a>.</p>
    <div class="print-demo">
      <form class="order" data-order-form data-user={person.email.user} data-domain={person.email.domain}>
        <label for="order-msg">Your order</label>
        <textarea id="order-msg" name="message" rows="3" maxlength="300">Liked the menu. Free to talk about a Summer 2027 internship?</textarea>
        <label for="order-from">From</label>
        <input id="order-from" name="from" maxlength="60" value="" placeholder="Your name and company" />
        <button class="key" type="submit">Fire</button>
        <p class="fine" data-order-status aria-live="polite">Nothing is sent until you press send in your email app.</p>
      </form>
      <div>
        <div class="feed">
          <div class="paper" data-paper>
            <p class="center">HOUSE OF CHEN{'\n'}*** NEW ORDER ***</p>
            <p class="center">TICKET <span data-ticket-no>00412</span></p>
            <hr />
            <p data-ticket-msg>LIKED THE MENU. FREE TO TALK ABOUT A SUMMER 2027 INTERNSHIP?</p>
            <hr />
            <p>FROM: <span data-ticket-from>A HIRING MANAGER</span></p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <p>&nbsp;</p>
            <span class="heard" data-heard>Heard</span>
          </div>
        </div>
        <div class="printer-body" aria-hidden="true"><span class="led"></span><span class="taped">Kenney's desk</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { play } from '../lib/sound';

  const form = document.querySelector<HTMLFormElement>('[data-order-form]');
  if (form) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const paper = document.querySelector<HTMLElement>('[data-paper]')!;
    const stamp = document.querySelector<HTMLElement>('[data-heard]')!;
    const status = document.querySelector<HTMLElement>('[data-order-status]')!;
    const message = form.querySelector<HTMLTextAreaElement>('#order-msg')!;
    const from = form.querySelector<HTMLInputElement>('#order-from')!;
    const out = (name: string) => document.querySelector<HTMLElement>(`[data-ticket-${name}]`)!;
    let ticketNumber = 412;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = message.value.trim() || 'One internship, please.';
      const who = from.value.trim() || 'A visitor';
      out('msg').textContent = text.toUpperCase();
      out('from').textContent = who.toUpperCase();
      ticketNumber += 1;
      out('no').textContent = String(ticketNumber).padStart(5, '0');

      const address = `${form.dataset.user}@${form.dataset.domain}`;
      const openMail = () => {
        const subject = encodeURIComponent(`Order from your site: ${who}`);
        const body = encodeURIComponent(`${text}\n\nFrom: ${who}`);
        status.textContent = `Your email app should open with this order filled in. If it didn't, the address is ${address}.`;
        location.href = `mailto:${address}?subject=${subject}&body=${body}`;
      };

      if (calm || !paper.animate) {
        openMail();
        return;
      }
      for (const a of [...paper.getAnimations(), ...stamp.getAnimations()]) a.cancel();
      stamp.style.opacity = '0';
      status.textContent = 'Printing your ticket.';
      play('print');
      paper
        .animate([{ transform: 'translateY(100%)' }, { transform: 'translateY(0)' }], { duration: 1300, easing: 'steps(20, end)' })
        .finished.then(() => {
          stamp.style.opacity = '1';
          play('stamp');
          stamp.animate([{ opacity: 0, transform: 'rotate(-9deg) scale(1.9)' }, { opacity: 1, transform: 'rotate(-9deg) scale(1)' }], { duration: 130, easing: 'cubic-bezier(.3,0,.2,1)' });
          paper.animate([{ transform: 'translateY(0)' }, { transform: 'translateY(3px)' }, { transform: 'translateY(0)' }], { duration: 120, delay: 110 });
          window.setTimeout(openMail, 500);
        }, () => {});
    });
  }
</script>
