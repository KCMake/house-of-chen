---
import '@fontsource-variable/familjen-grotesk/index.css';
import '@fontsource/source-code-pro/400.css';
import '@fontsource/source-code-pro/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // With JavaScript, the About paragraph's phrases start closed. If its script never runs,
      // open everything again so nothing is hidden for good.
      document.documentElement.classList.add('js');
      addEventListener('load', function () {
        var root = document.documentElement;
        if (document.querySelector('[data-sentence]') && !root.classList.contains('sentence-ready')) root.classList.remove('js');
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131312" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      // The email address is put together in the browser so it isn't sitting in the HTML for scrapers.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-mail]')) {
        const address = `${link.dataset.mail}@${link.dataset.domain}`;
        link.href = `mailto:${address}`;
        if (link.hasAttribute('data-show-address')) link.textContent = address;
      }
      console.log('%cHi. The code for this site is at github.com/KCMake/house-of-chen.', 'font: 15px monospace');
    </script>
  </body>
</html>
