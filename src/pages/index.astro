---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Sentence from '../components/Sentence.astro';
import TopBar from '../components/TopBar.astro';
import WorkList from '../components/WorkList.astro';
import { person } from '../data/site';
import { url } from '../lib/url';
import '../styles/home.css';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: new URL(url(), Astro.site).href,
  affiliation: 'Georgia Institute of Technology',
  sameAs: [person.linkedin, person.github],
  knowsAbout: ['Backend systems', 'AI agents', 'Embedded systems'],
};
---
<Base
  title="Kenney Chen"
  description="Kenney Chen studies computer engineering at Georgia Tech and is looking for a Summer 2027 software engineering internship. From an AI that answered a restaurant's phones to a map of every free curb in Atlanta."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <TopBar />
  <main id="main">
    <section class="intro" aria-labelledby="intro-title">
      <div class="wrap">
        <h1 class="visually-hidden" id="intro-title">{person.name}</h1>
        <Sentence />
      </div>
    </section>
    <WorkList />
  </main>
  <Footer />
</Base>
