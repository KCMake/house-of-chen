---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import CurbDemo from '../components/CurbDemo.astro';
import TopBar from '../components/TopBar.astro';
import WorkList from '../components/WorkList.astro';
import { person } from '../data/site';
import { url } from '../lib/url';
import '../styles/home.css';
import '../styles/demo.css';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: new URL(url(), Astro.site).href,
  affiliation: 'Georgia Institute of Technology',
  sameAs: [person.linkedin, person.github],
  knowsAbout: ['Backend systems', 'AI agents', 'Embedded systems'],
};
---
<Base
  title="Kenney Chen"
  description="Kenney Chen studies computer engineering at Georgia Tech and is looking for a Summer 2027 software engineering internship. From an AI that answered a restaurant's phones to a map of every free curb in Atlanta."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <TopBar />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <CurbDemo>
          <h1 class="hero-title" id="hero-title">{person.name}</h1>
          <p class="hero-lede">I study computer engineering at Georgia Tech and build software that does a real job for someone. I'm looking for a software engineering internship for Summer 2027.</p>
          <p class="hero-links">
            <a href="#contact" data-mail={person.email.user} data-domain={person.email.domain}>Email me</a>
            <a href={url('resume/')}>Resume</a>
            <a href={person.github}>GitHub</a>
          </p>
          <div class="running">
            <h2 class="running-title"><span class="running-live" aria-hidden="true"></span>Running on this page: <b>Free Curb ATL</b></h2>
            <p class="running-note">My map of which Atlanta curbs are free to park on. Change the day or the hour and it works out all 2,035 blocks again. <a href={url('work/free-curb-atl/')}>How I built it</a></p>
          </div>
        </CurbDemo>
      </div>
    </section>
    <WorkList />
  </main>
  <Footer />
</Base>
