---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';
import { url } from '../lib/url';
---
<Base title="Not found: Kenney Chen" description="This page isn't on the site." noindex>
  <TopBar />
  <main id="main" class="wrap notfound">
    <h1>Nothing here</h1>
    <p>That page isn't on this site. Everything is on <a href={url()}>the homepage</a>, in one paragraph.</p>
  </main>
  <Footer />
</Base>

<style>
  .notfound { padding-block: clamp(40px, 8vw, 96px) 0; }
  .notfound h1 { font-size: clamp(38px, 4vw + 18px, 64px); line-height: 1.05; letter-spacing: -0.025em; }
  .notfound p { max-width: 34em; margin-top: 14px; font-size: 20px; }
</style>
