---
import Base from '../../layouts/Base.astro';
import SignBar from '../../components/SignBar.astro';
import { kitchenTickets } from '../../data/projects';
import { shelves } from '../../data/site';
import { url } from '../../lib/url';
import '../../styles/front.css';
import '../../styles/kitchen.css';

const cuts = kitchenTickets.flatMap((p) => (p.kitchen?.cut ?? []).map((c) => ({ ...c, project: p.name })));
---
<Base
  title="Back of house: Kenney Chen"
  description="The kitchen behind Kenney Chen's portfolio: architecture, real code, and what broke, for every dish on the menu."
  room="kitchen"
>
  <SignBar room="kitchen" />
  <main id="main" class="kitchen">
    <div class="tube" aria-hidden="true"></div>
    <section class="band">
      <div class="wrap">
        <p class="tape tape-big">Back of house</p>
        <h1 class="k-title">The kitchen</h1>
        <p class="k-lede">This is where the dishes on the menu get made. Every ticket on the rail has the architecture, real code from the repo where there is one, and a Refire log of what broke and how it got fixed.</p>
      </div>
    </section>

    <section class="band" aria-labelledby="rail-title">
      <div class="wrap">
        <h2 class="visually-hidden" id="rail-title">Tickets on the rail</h2>
        <div class="k-rail" aria-hidden="true"></div>
        <ul class="k-tickets">
          {kitchenTickets.map((p) => (
            <li class="k-ticket">
              <a href={url(`kitchen/${p.slug}/`)}>
                <span class="kt-no">{p.number}</span>
                <span class="kt-name">{p.name}</span>
                <span>{p.kitchen!.line.length} STEPS ON THE LINE</span>
                <span>{p.kitchen!.printouts?.length ?? 0} PRINTOUTS</span>
                <span>{p.kitchen!.refires?.length ?? 0} REFIRES</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band" aria-label="Whiteboard and shelves">
      <div class="wrap k-two">
        <div class="whiteboard">
          <h2>86'd</h2>
          <ul>
            {cuts.map((c) => (
              <li><s><span>{c.what}</span></s><br />{c.why} ({c.project})</li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="k-h2">Mise en place</h2>
          {shelves.map((shelf) => (
            <div class="shelf">
              <h3>{shelf.name}</h3>
              <ul>{shelf.items.map((item) => <li class="deli"><span>{item}</span></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap k-nav">
        <a class="key" href={url()}>Back to the front</a>
        <a class="key key-quiet" href={url('to-go/')}>To go</a>
      </div>
    </section>
  </main>
</Base>
