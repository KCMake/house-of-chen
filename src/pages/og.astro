---
import Base from '../layouts/Base.astro';

// The link preview. scripts/make-assets.mjs screenshots this page at 1200 by 630.
---
<Base title="Kenney Chen" description="The link preview image." noindex>
  <main id="main" class="og">
    <p class="og-name">Kenney Chen</p>
    <p class="og-text">I'm Kenney Chen, <span class="og-mark">a computer engineering student at Georgia Tech</span> looking for <span class="og-mark">a software engineering internship for Summer 2027</span>.</p>
    <p class="og-foot">One of my projects runs on the first screen.</p>
  </main>
</Base>

<style>
  .og { display: flex; flex-direction: column; justify-content: space-between; width: 1200px; height: 630px; padding: 72px 84px 64px; background: var(--paper); color: var(--ink); }
  .og-name { font-size: 28px; font-weight: 700; }
  .og-text { max-width: 19em; font-size: 60px; line-height: 1.2; letter-spacing: -0.015em; }
  .og-mark { background: linear-gradient(var(--mark), var(--mark)) 0 92% / 100% 40% no-repeat; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .og-foot { font: 400 22px/1 var(--mono); color: var(--soft); }
</style>
